// Cloudflare Workers with static assets: `npm run deploy` publishes dist (the build for any address).
{
  "name": "polish-czytanie",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
